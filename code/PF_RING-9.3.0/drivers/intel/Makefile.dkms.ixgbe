all: install

add: veryclean
	\/bin/rm -rf /usr/src/ixgbe-zc-5.19.6.1
	mkdir /usr/src/ixgbe-zc-5.19.6.1
	cd ixgbe/ixgbe-5.19.6-zc/src ; make clean; cp -r * /usr/src/ixgbe-zc-5.19.6.1
	cp ../../kernel/linux/pf_ring.h /usr/src/ixgbe-zc-5.19.6.1
	sed -i -e 's/ixgbe\.o/ixgbe_zc.o/' -e 's/ixgbe-/ixgbe_zc-/' /usr/src/ixgbe-zc-5.19.6.1/Kbuild
	mv /usr/src/ixgbe-zc-5.19.6.1/Kbuild /usr/src/ixgbe-zc-5.19.6.1/Makefile
	sed -i '1iPF_RING_PATH=\/usr\/src\/pfring-9.3.0.1' /usr/src/ixgbe-zc-5.19.6.1/Makefile
	sed -i -e 's/#HAVE_PF_RING_DKMS //' /usr/src/ixgbe-zc-5.19.6.1/common.mk
	cp dkms.conf.ixgbe /usr/src/ixgbe-zc-5.19.6.1/dkms.conf 
	dkms add -m ixgbe-zc -v 5.19.6.1

build: add
	dkms build -m ixgbe-zc -v 5.19.6.1

install: build
	dkms install --force -m ixgbe-zc -v 5.19.6.1

deb: add add_deb install
	dkms mkdeb -m ixgbe-zc -v 5.19.6.1 --source-only

rpm: add add_rpm install
	dkms mkrpm -m ixgbe-zc -v 5.19.6.1 --source-only

add_rpm:
	cp -f zc.spec /usr/src/ixgbe-zc-5.19.6.1/ixgbe-zc-dkms-mkrpm.spec

add_deb:
	cp -r zc-dkms-mkdeb /usr/src/ixgbe-zc-5.19.6.1/ixgbe-zc-dkms-mkdeb

remove:
	-dkms remove -m ixgbe-zc -v 5.19.6.1 --all
	\/bin/rm -f /lib/modules/*/weak-updates/ixgbe*ko
	\/bin/rm -f /lib/modules/*/extra/ixgbe*ko
	\/bin/rm -rf /var/lib/dkms/ixgbe-zc

veryclean: remove
	\/bin/rm -fr /usr/src/ixgbe-zc-5.19.6.1
	
