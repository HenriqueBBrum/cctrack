all: install

add: veryclean
	\/bin/rm -rf /usr/src/iavf-zc-4.9.5.1
	mkdir -p /usr/src/iavf-zc-4.9.5.1/
	cp iavf/iavf-4.9.5-zc/scripts/check_aux_bus /usr/src/iavf-zc-4.9.5.1/
	cd iavf/iavf-4.9.5-zc/src/ ; make clean; cp -r * /usr/src/iavf-zc-4.9.5.1/
	cp ../../kernel/linux/pf_ring.h /usr/src/iavf-zc-4.9.5.1/
	sed -i -e 's/iavf\.o/iavf_zc.o/' -e 's/iavf-/iavf_zc-/' /usr/src/iavf-zc-4.9.5.1/Kbuild
	mv /usr/src/iavf-zc-4.9.5.1/Kbuild /usr/src/iavf-zc-4.9.5.1/Makefile
	sed -i '1iPF_RING_PATH=\/usr\/src\/pfring-9.3.0.1' /usr/src/iavf-zc-4.9.5.1/Makefile
	sed -i -e 's/#HAVE_PF_RING_DKMS //' /usr/src/iavf-zc-4.9.5.1/common.mk
	cp dkms.conf.iavf /usr/src/iavf-zc-4.9.5.1/dkms.conf 
	dkms add -m iavf-zc -v 4.9.5.1

build: add
	dkms build -m iavf-zc -v 4.9.5.1

install: build
	dkms install --force -m iavf-zc -v 4.9.5.1

deb: add add_deb install
	dkms mkdeb -m iavf-zc -v 4.9.5.1 --source-only

rpm: add add_rpm install
	dkms mkrpm -m iavf-zc -v 4.9.5.1 --source-only

add_rpm:
	cp -f zc.spec /usr/src/iavf-zc-4.9.5.1/iavf-zc-dkms-mkrpm.spec

add_deb:
	cp -r zc-dkms-mkdeb /usr/src/iavf-zc-4.9.5.1/iavf-zc-dkms-mkdeb
	-cd  /usr/src/iavf-zc-4.9.5.1/iavf-zc-dkms-mkdeb ; find . -type d -name ".git" -exec rm -fr {} \;

remove:
	-dkms remove -m iavf-zc -v 4.9.5.1 --all
	\/bin/rm -f /lib/modules/*/weak-updates/iavf*ko
	\/bin/rm -f /lib/modules/*/extra/iavf*ko
	\/bin/rm -rf /var/lib/dkms/iavf-zc

veryclean: remove
	\/bin/rm -fr /usr/src/iavf-zc-4.9.5.1
	
